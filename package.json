{
  "name": "sanity-plugin-icon-manager",
  "version": "3.0.0",
  "description": "A Sanity plugin for selecting, managing, and customizing icons.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "sanity-plugin-icon-manager"
  ],
  "homepage": "https://github.com/williamiommi/sanity-plugin-icon-manager#readme",
  "bugs": {
    "url": "https://github.com/williamiommi/sanity-plugin-icon-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:williamiommi/sanity-plugin-icon-manager.git"
  },
  "license": "MIT",
  "author": "William Iommi <william.iommi@gmail.com>",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict",
    "dev": "npm-run-all --parallel watch dev:studio",
    "dev:studio": "npm --prefix dev run dev",
    "prepare": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/incompatible-plugin": "^1.0.4",
    "@sanity/ui": "^3.1.14",
    "dompurify": "^3.2.4",
    "react-colorful": "^5.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@iconify/types": "^2.0.0",
    "@sanity/pkg-utils": "^10.4.12",
    "@sanity/plugin-kit": "^4.0.20",
    "@sanity/semantic-release-preset": "^5.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-sanity": "^7.1.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^2.5.1",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-is": "^19.2.2",
    "rimraf": "^5.0.1",
    "sanity": "^6.2.0",
    "styled-components": "^6.1.15",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^5.0.0 || ^6.0.0",
    "styled-components": "^6.1.15"
  },
  "engines": {
    "node": ">=22.12"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "nodeEngine": false
    }
  }
}
